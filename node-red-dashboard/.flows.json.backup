    {
        "id": "e3b484fffdf083bd",
        "type": "function",
        "z": "8b8f80d3498d1150",
        "name": "setup node",
        "func": "// Get the existing list of pending devices, or start fresh\nlet pending = flow.get(\"pending_devices\") || [];\n\nconst newUid = msg.payload.uid;\n\n// Don't add the same UID twice if it announces itself again\nconst alreadyPending = pending.some(d => d.uid === newUid);\nif (!alreadyPending) {\n    pending.push({\n        uid: newUid,\n        status: \"UNREGISTERED\",\n        firstSeen: new Date().toLocaleTimeString()\n    });\n    flow.set(\"pending_devices\", pending);\n}\n\n// Emit the full current list so downstream nodes can render it\nmsg.payload = pending;\nreturn msg;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 140,
        "wires": [
            [
                "37fbc93046a26c33",
                "3af509ec505e6f38"
            ]
        ]
    },
    {
        "id": "37fbc93046a26c33",
        "type": "ui-template",
        "z": "8b8f80d3498d1150",
        "group": "d99f53718476b1e1",
        "page": "",
        "ui": "",
        "name": "",
        "order": 4,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div>\n    <h3 v-if=\"!msg || !msg.payload || msg.payload.length === 0\">\n      No pending devices\n    </h3>\n    <table v-else style=\"width: 100%; border-collapse: collapse;\">\n      <thead>\n        <tr style=\"text-align: left; border-bottom: 1px solid #ccc;\">\n          <th>UID</th>\n          <th>Status</th>\n          <th>First seen</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr v-for=\"device in msg.payload\" :key=\"device.uid\">\n          <td>{{ device.uid }}</td>\n          <td style=\"color: orange;\">{{ device.status }}</td>\n          <td>{{ device.firstSeen }}</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</template>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 720,
        "y": 140,
        "wires": [

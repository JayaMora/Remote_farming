    {
        "id": "427bf87890f1adb0",
        "type": "function",
        "z": "9e7d7c12d1458246",
        "name": "field Main water Tracker",
        "func": "const FLOW_RATE_ML_PER_SEC = 100;  // assumption: small irrigation valve\nconst state = msg.payload;\nconst now = Date.now();\n\n// Per-field tracking state stored in flow context\nlet tracker = flow.get(\"field_main_water\") || {\n    openedAt: null,    // timestamp when valve last went OPEN\n    totalMl: 0          // cumulative water used (ml)\n};\n\nif (state === \"ON\" && tracker.openedAt === null) {\n    // Valve just opened — mark the timestamp\n    tracker.openedAt = now;\n} else if (state === \"OFF\" && tracker.openedAt !== null) {\n    // Valve just closed — add the elapsed open time to total\n    const elapsedSec = (now - tracker.openedAt) / 1000;\n    tracker.totalMl += elapsedSec * FLOW_RATE_ML_PER_SEC;\n    tracker.openedAt = null;\n}\n\nflow.set(\"field_main_water\", tracker);\n\n// Emit current total in litres for downstream display\nmsg.payload = (tracker.totalMl / 1000).toFixed(2);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 460,
        "wires": [
            [
                "c46320386a2fdcb7",
                "290f466847993470"
            ]
        ]
    },

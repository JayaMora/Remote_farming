    {
        "id": "baee1ee3496aa426",
        "type": "function",
        "z": "8b8f80d3498d1150",
        "name": "Bind Device",
        "func": "const uid = flow.get(\"selected_uid\");\nconst slot = flow.get(\"selected_slot\");\n\nif (!uid || !slot) {\n    node.warn(\"Pick a UID and a slot first\");\n    return null;\n}\n\nconst bindCommand = { uid: uid, slot: slot };\n\n// Remove the bound device from pending\nlet pending = flow.get(\"pending_devices\") || [];\npending = pending.filter(d => d.uid !== uid);\nflow.set(\"pending_devices\", pending);\n\n// Remove the consumed slot from free_slots\nlet freeSlots = flow.get(\"free_slots\") || [];\nfreeSlots = freeSlots.filter(s => s !== slot);\nflow.set(\"free_slots\", freeSlots);\n\n// Clear stashed selections so the UI doesn't carry stale picks\nflow.set(\"selected_uid\", null);\nflow.set(\"selected_slot\", null);\n\nreturn [\n    { payload: bindCommand, topic: \"gateway/command/bind\" },\n    { payload: pending }\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 310,
        "y": 240,

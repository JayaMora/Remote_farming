    {
        "id": "0da6957652028c17",
        "type": "function",
        "z": "697288345ed13a06",
        "name": "Parse Lora data",
        "func": "const raw = msg.payload.toString();\nconst parsed = {};\n\nraw.split(\",\").forEach(pair => {\n    const [key, value] = pair.split(\":\");\n    if (key && value !== undefined) {\n        parsed[key.trim()] = parseFloat(value);\n    }\n});\n\n// Build separate messages — one per sensor — each as plain numeric payload,\n// matching the format Field A's existing flows expect\nreturn [\n    { payload: parsed.H, topic: \"field_a/humidity\" },\n    { payload: parsed.T, topic: \"field_a/temperature\" },\n    { payload: parsed.S, topic: \"field_a/moisture\" }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 140,
        "wires": [
            [],
            [
                "3a88417352a44477"
            ],
            [
                "959027b21b87dec6"
            ]
        ]
    },

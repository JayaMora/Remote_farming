    {
        "id": "318b8cbac7dc437d",
        "type": "function",
        "z": "c3a686be6941f8d4",
        "name": "build URL",
        "func": "const mode = flow.get(\"locationMode\") || \"city\";\nconst apiKey = \"a163ac642eeecd0bb9240cc34b74f994\";\nconst base = \"https://api.openweathermap.org/data/2.5/weather\";\n\nif (mode === \"city\") {\n    const city = flow.get(\"cityInput\") || \"London,GB\";\n    msg.url = `${base}?q=${encodeURIComponent(city)}&appid=${apiKey}&units=metric`;\n    // no lat/lon known yet here — map won't update in this branch\n} else {\n    const lat = flow.get(\"lat\") || \"51.5\";\n    const lon = flow.get(\"lon\") || \"-0.12\";\n    msg.url = `${base}?lat=${lat}&lon=${lon}&appid=${apiKey}&units=metric`;\n\n    const delta = 0.025;\n    msg.mapUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${lon - delta},${lat - delta},${lon + delta},${lat + delta}&layer=mapnik&marker=${lat},${lon}`;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 140,
        "wires": [
            [
                "50e1e43e6d897ea2",
                "0f6d4332df63e4ca"
            ]
        ]
    },
    {
        "id": "50e1e43e6d897ea2",
        "type": "http request",
        "z": "c3a686be6941f8d4",
        "name": "",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 410,
        "y": 140,
        "wires": [
            [
                "7df4d3b739bbb926"
            ]
        ]
    },
    {
        "id": "7df4d3b739bbb926",
        "type": "function",
        "z": "c3a686be6941f8d4",
        "name": "parse Response",
        "func": "const d = msg.payload;\n\nif (!d || d.cod !== 200) {\n    node.warn(\"Bad API response: \" + JSON.stringify(d));\n    return null;\n}\n\n// Store parsed values in flow context for other nodes to use\nconst weather = {\n    city: d.name + \", \" + d.sys.country,\n    description: d.weather[0].description,\n    temp: d.main.temp,\n    humidity: d.main.humidity,\n    pressure: d.main.pressure,\n    windSpeed: d.wind.speed * 3.6,          // m/s → km/h\n    windDeg: d.wind.deg,\n    sunrise: new Date(d.sys.sunrise * 1000).toLocaleTimeString(),\n    sunset: new Date(d.sys.sunset * 1000).toLocaleTimeString(),\n    icon: d.weather[0].icon\n};\n\nflow.set(\"lastWeather\", weather);\n\n// Send the full object downstream\nmsg.payload = weather;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 140,
        "wires": [
            [
                "5411972e2914a32b",
                "d2dbe810654b9cdd",
                "e5e680f4cd8556bc",
                "5dd7a5c9b0a1a7f5",

    {
        "id": "999eeb4be0926d89",
        "type": "function",
        "z": "c3a686be6941f8d4",
        "name": "Notification",
        "func": "const weather = msg.payload;\nconst param = flow.get(\"warnParam\") || \"temp\";\nconst limit = flow.get(\"warnLimit\") || 30;\nconst value = weather[param];\nconst labels = { temp: \"Temperature\", humidity: \"Humidity\", pressure: \"Pressure\", windSpeed: \"Wind Speed\" };\nconst units = { temp: \"°C\", humidity: \"%\", pressure: \"hPa\", windSpeed: \"km/h\" };\nif (value !== undefined && value > limit) {\n    msg.payload = `Warning! ${labels[param]} is ${value}${units[param]}. Exceeds limit by ${Math.round((value - limit) * 10) / 10}${units[param]}`;\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1090,
        "y": 620,
        "wires": [
            [
                "03edb9bd14172dd1"
            ]
        ]
    },
    {

        "type": "function",
        "z": "9e7d7c12d1458246",
        "name": "Field MAIN efficiency",
        "func": "const state = msg.payload;\n\n// Only evaluate at the moment the valve opens\nif (state !== \"ON\") {\n    return null;\n}\n\nconst moisture = flow.get(\"field_main_latest_moisture\");\nconst threshold = flow.get(\"field_main_threshold_moisture\");\n\n// Need both to evaluate; bail if we haven't seen them yet\nif (moisture === undefined || threshold === undefined) {\n    return null;\n}\n\nlet stats = flow.get(\"field_main_efficiency\") || { needed: 0, wasted: 0 };\n\nif (moisture < threshold) {\n    stats.needed += 1;   // soil was dry — irrigation was justified\n} else {\n    stats.wasted += 1;   // soil was already wet — wasted water\n}\n\nflow.set(\"field_main_efficiency\", stats);\n\nconst total = stats.needed + stats.wasted;\nconst efficiency = total === 0 ? 0 : (stats.needed / total) * 100;\n\nmsg.payload = efficiency.toFixed(1);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 640,
        "wires": [
            [
                "8065ceb7080f9a78"
            ]
        ]
